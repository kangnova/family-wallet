# Copy this file to .env and adjust for your environment.
# .env is gitignored; this example is safe to commit.

# PostgreSQL connection string (see docker-compose.yml for the dev database)
DATABASE_URL="postgresql://family_wallet:family_wallet_dev@localhost:5433/family_wallet?schema=public"

# Auth (Auth.js) — generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
